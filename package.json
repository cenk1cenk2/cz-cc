{
  "name": "@cenk1cenk2/cz-cc",
  "version": "3.0.1",
  "description": "Commitizen adapter following the conventional-changelog format.",
  "repository": "git@gitlab.kilic.dev:libraries/cz-cc.git",
  "author": "Cenk Kilic <cenk@kilic.dev>",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.js",
    "dev:start": "tsdown --watch src/index.js",
    "format": "prettier --log-level warn --write src/ && eslint --fix",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p jsconfig.json"
  },
  "engines": {
    "node": ">= 24"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "@listr2/prompt-adapter-inquirer": "^4.3.3",
    "commitizen": "^4.3.2",
    "conventional-commit-types": "^3.0.0",
    "find-git-root": "^1.1.0",
    "listr2": "^11.4.0"
  },
  "devDependencies": {
    "@cenk1cenk2/eslint-config": "^3.4.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3"
  },
  "config": {
    "commitizen": {
      "path": "./dist/index.cjs"
    }
  },
  "packageManager": "pnpm@12.13.0"
}
